# Keep recovered proprietary assets and local credentials OUT of every image.
.git
.github
data
docs
tools
**/node_modules
**/.next
**/.venv
**/__pycache__
**/.pytest_cache
**/*.pyc
.env
.env.*
!.env.example
*.sqlite
*.db
*.partial-*

# Isolated LOCAL QA credentials, logs, browser captures and database archives.
# These must not enter Docker's build context, even as unused files.
.qa-local/
test-output/
backups/
**/*.dump
**/.env.*
