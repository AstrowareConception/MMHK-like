  "_carrieres": [
    {
      "nom": "Architecte",
      "description": "Plus efficace pour attaquer et défendre les cités, ainsi que pour la construction. Permet de fabriquer des catapultes."
    },
    {
      "nom": "Barbare",
      "description": "Formé pour repérer les éclaireurs ennemis. Bonnes capacités de pillage et d'interception de troupes ennemies en déroute. Permet de capturer les éclaireurs ennemis."
    },
    {
      "nom": "Bâtisseur",
      "description": " Augmente les revenus. Permet de construire des ateliers d'exploitation. Un bon choix pour donner un coup de pouce à votre économie."
    },
    {
      "nom": "Chevalier",
      "description": "Unités plus puissantes en défense. Permet de construire des forts. Aucun royaume n'est vraiment protégé sans un chevalier."
    },
    {
      "nom": "Clerc",
      "ecole": 2,
      "description": "Capable de lancer des sorts de l'École de la Lumière, efficaces pour améliorer vos troupes."
    },
    {
      "nom": "Combattant",
      "description": "Unités plus puissantes en attaque. Peut utiliser les armes magiques. Très utile pour éliminer les monstres autour d'une cité."
    },
    {
      "nom": "Invocateur",
      "ecole": 0,
      "description": "Capable de lancer des sorts de l'École de l'Invocation. Invoquer des troupes est un bon moyen pour tuer des monstres sans mettre en danger vos troupes."
    },
    {
      "nom": "Magicien de la destruction",
      "ecole": 3,
      "description": "Capable de lancer des sorts de l'École de la Destruction, très efficaces pour tuer les troupes ennemies."
    },
    {
      "nom": "Magicien des ténèbres",
      "ecole": 1,
      "description": "Capable de lancer des sorts de l'École des Ténèbres, très efficaces pour tuer les troupes faibles et pour affaiblir les héros ennemis."
    },
    {
      "nom": "Marchand",
      "description": "Très habile dans la manipulation des caravanes et les arcanes du commerce, le marchand augmente la vitesse et la capacité de vos caravanes tout en maximisant les bénéfices de vos ventes directes."
    },
    {
      "nom": "Meneur",
      "description": "Produit et recrute les unités plus rapidement. Permet de recruter les unités de rang 7."
    },
    {
      "nom": "Rôdeur",
      "description": "Meilleur éclaireur. Peut effectuer des reconnaissances de cités ou de régions. Utile pour garder un œil sur ses voisins."
    },
    {
      "nom": "Tenancier",
      "description": "Réduit le coût des actions à la taverne et augmente leur efficacité. Réduit les coûts de maintenance."
    }
  ],
