# SSH-tunnel-only preview, never a public production certificate.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/mmhk
COPY apps/api/ /opt/mmhk/apps/api/
RUN python -m pip install --no-cache-dir /opt/mmhk/apps/api
RUN useradd --system --uid 10001 --create-home mmhk
USER mmhk
EXPOSE 8000
CMD ["uvicorn","mmhk_api.main:app","--host","0.0.0.0","--port","8000","--no-proxy-headers"]
