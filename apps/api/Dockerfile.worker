# Local/controlled deployment only; not a public game image.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/mmhk
COPY apps/api/ /opt/mmhk/apps/api/
RUN python -m pip install --no-cache-dir /opt/mmhk/apps/api
RUN useradd --system --uid 10001 --create-home mmhk
USER mmhk
CMD ["python", "-m", "mmhk_api.supervised_worker", "--loop", "--interval-seconds", "10"]
