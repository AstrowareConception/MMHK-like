# Private preview only. A dependency lockfile is required before a public
# production deployment; current npm install is NOT fully reproducible.
FROM node:22-alpine AS build
WORKDIR /opt/web
COPY apps/web/package.json ./
COPY apps/web/tsconfig.json apps/web/next.config.ts apps/web/next-env.d.ts ./
RUN npm install --no-audit --no-fund
COPY apps/web/app ./app
COPY apps/web/components ./components
COPY apps/web/lib ./lib
# Whitelisted original public-safe theme assets only (no data/ tree).
COPY apps/web/public ./public
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /opt/web
COPY --from=build --chown=node:node /opt/web/package.json ./package.json
COPY --from=build --chown=node:node /opt/web/node_modules ./node_modules
COPY --from=build --chown=node:node /opt/web/.next ./.next
COPY --from=build --chown=node:node /opt/web/public ./public
COPY --from=build --chown=node:node /opt/web/next.config.ts ./next.config.ts
USER node
EXPOSE 3000
CMD ["npm","run","start"]
